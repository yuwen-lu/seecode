# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloned repos (for analysis)
/clicky/
/tmp-repos/

# prototype artifacts
/prototype/

# claude code
.claude/
.agents/
skills-lock.json
.impeccable.md
.playwright-mcp/

# screenshots from testing
*.png

# SQLite cache
.seecode-cache.db
.seecode-cache.db-wal
.seecode-cache.db-shm
